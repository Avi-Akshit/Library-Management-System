# Local Docker configuration. This file contains no real credentials.
# Copy it to .env and replace JWT_SECRET before running Docker.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Docker uses its bundled MongoDB service by default. Uncomment only when you
# intentionally deploy against an externally managed MongoDB database.
# MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/lms

# Email delivery remains disabled until the Gmail feature is enabled.
EMAIL_PROVIDER=console

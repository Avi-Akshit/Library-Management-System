NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/lms
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
WEB_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=console
# Gmail is deliberately disabled until the email feature is enabled for deployment.
# When that happens, set EMAIL_PROVIDER=gmail and provide these values only in the
# deployment provider's secret manager, never in this repository.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=LMS <onboarding@resend.dev>
LIBRARY_NAME=Central Library
LIBRARY_CODE=CENTRAL
LIBRARY_ADDRESS=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Library Administrator
# SMTP leftover keys are unused; email goes through RESEND_API_KEY or console
